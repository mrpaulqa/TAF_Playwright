pipeline {
    agent any

    tools {
        // Jenkins сам поймет, какая ОС на агенте, скачает нужный дистрибутив,
        // распакует в свою изолированную папку tools/ и сам выставит валидный JAVA_HOME.
        jdk 'JDK_17'
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()
                checkout scm
            }
        }
        stage('Run QA Tests on Windows') {
            steps {
                // Чистый запуск. Gradle подхватит JAVA_HOME, созданный Jenkins автоматически
                bat 'gradlew.bat test'
            }
        }
    }
}