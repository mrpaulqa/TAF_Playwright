pipeline {
    agent any

    tools {
        jdk 'JDK_17'
    }
    environment {
        TEST_REPORT_EMAIL = credentials('TEST_REPORT_EMAIL')
        THINKING_TOKEN = credentials('THINKING_TOKEN')
    }
    triggers {
        cron('H 2 * * 1-5')
    }

    // Храним настройки времени и параметров в одном месте
    options {
        timeout(time: 1, unit: 'HOURS') // Защита от бесконечного зависания тестов
        timestamps()                     // Добавляет время к каждой строчке лога
        buildDiscarder(logRotator(numToKeepStr: '10')) // Храним только последние 10 сборок (экономим диск)
    }

    parameters {
        // Позволяет при ручном запуске выбрать, что именно гоним
        choice(name: 'TEST_SUITE', choices: ['ui', 'api', 'db', 'all'], description: 'Какой набор тестов запустить')
    }

    stages {
        stage('Run Tests') {
            steps {
                script {
                    def testTag = ''

                    // 1. Если это запуск из Pull Request -> СТРОГО smoke (api)
                    if (env.CHANGE_ID) {
                        echo "Авто-запуск для PR #${env.CHANGE_ID}: прогоняем только Smoke-тесты"
                        testTag = 'api'
                    }
                    // Исправлено: просто задаем тег 'all' для мастера/мейна, чтобы избежать двойного запуска
                    else if (env.BRANCH_NAME == 'master' || env.BRANCH_NAME == 'main') {
                        echo "Изменения влиты в ${env.BRANCH_NAME}: готовим запуск полного регресса!"
                        testTag = 'all'
                    }
                    // 2. Если запуск по расписанию (Cron / Nightly) -> полный регресс (ui)
                    else if (BUILD_CAUSE == 'TIMERTRIGGER') {
                        echo "Ночной авто-запуск: прогоняем полный Regression"
                        testTag = 'ui'
                    }
                    // 3. Если запустили руками из UI -> берем выбор из параметров
                    else {
                        echo "Ручной запуск: выбран сьют ${params.TEST_SUITE}"
                        testTag = params.TEST_SUITE
                    }

                    // Единая точка запуска тестов с правильным тегом
                   bat "gradlew.bat clean test -Dtag=${testTag} --no-daemon -DthinkingToken=\"${THINKING_TOKEN}\""
                }
            }
        }
    }

    // Секция post выполняется ВСЕГДА после прогона (даже если тесты упали)
    post {
        always {
            allure commandline: 'allure_cli',
                   includeProperties: false,
                   jdk: '',
                   results: [[path: '**/allure-results']]

            // Исправлено: аргументы обернуты в скобки (), что решает проблему синтаксиса
            mail(
                to: env.TEST_REPORT_EMAIL,
                subject: "Результаты тестов: Job '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]",
                body: """
                     <html>
                     <body>
                          <h2>Статус сборки: ${currentBuild.currentResult}</h2>
                          <p>Автотесты завершены. Посмотреть Allure: <a href="${env.BUILD_URL}allure/">Allure Report</a></p>
                     </body>
                     </html>
                    """,
                mimeType: 'text/html'
            )
        }
    }
}