pipeline {
    agent any

    tools {
        jdk 'JDK_17'
        nodejs 'NodeJS-26'
    }
    environment {
        TEST_REPORT_EMAIL = credentials('TEST_REPORT_EMAIL')
        THINKING_EMAIL = credentials('THINKING_EMAIL')
        THINKING_PASSWORD = credentials('THINKING_PASSWORD')
    }
    triggers {
        cron('H 2 * * 1-5')
    }

    // Store time settings and parameters in one place
    options {
        timeout(time: 1, unit: 'HOURS') // Protection against infinite test hanging
        timestamps()                     // Adds timestamp to each log line
        buildDiscarder(logRotator(numToKeepStr: '10')) // Keep only the last 10 builds (save disk space)
    }

    parameters {
        // Allows choosing exactly what to run on manual trigger
        choice(name: 'TEST_SUITE', choices: ['ui', 'api', 'db', 'all'], description: 'Which test suite to run')
    }

    stages {
        stage('Run Tests') {
            steps {
                script {
                    def testTag = ''
                    if (env.CHANGE_ID) {
                        echo "Auto-run for PR #${env.CHANGE_ID}: running Smoke tests only"
                        testTag = 'api'
                    }
                    else if (env.BRANCH_NAME == 'master' || env.BRANCH_NAME == 'main') {
                        echo "Changes merged into ${env.BRANCH_NAME}: preparing to run full regression!"
                        testTag = 'all'
                    }
                    else if (BUILD_CAUSE == 'TIMERTRIGGER') {
                        echo "Nightly auto-run: running full Regression"
                        testTag = 'ui'
                    }
                    else {
                        echo "Manual run: selected suite ${params.TEST_SUITE}"
                        testTag = params.TEST_SUITE
                    }
                  bat 'gradlew.bat clean test -Dtag=%testTag% --no-daemon -Dapi.thinkingEmail="%THINKING_EMAIL%" -Dapi.thinkingPassword="%THINKING_PASSWORD%"'
                }
            }
        }
    }

    post {
        always {
            allure commandline: 'allure_cli',
                   includeProperties: false,
                   jdk: '',
                   results: [[path: '**/allure-results']]
            mail(
                to: env.TEST_REPORT_EMAIL,
                subject: "Test results: Job '${env.JOB_NAME}' [Build #${env.BUILD_NUMBER}]",
                body: """
                     <html>
                     <body>
                          <h2> Build status: ${currentBuild.currentResult}</h2>
                          <p>Automated tests completed. View Allure: <a href="${env.BUILD_URL}allure/">Allure Report</a></p>
                     </body>
                     </html>
                    """,
                mimeType: 'text/html'
            )
        }
    }
}